<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Network ────────────────────────────────────────────────────────── -->
    <!-- CRITICAL: Without INTERNET, Android blocks ALL outbound network calls -->
    <!-- in release builds — Supabase auth and FastAPI calls both fail silently -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── BLE Permissions (Android 12+ / API 31+) ───────────────────────── -->
    <!-- NOTE: neverForLocation flag was REMOVED intentionally.              -->
    <!-- That flag causes Android to redact device names from scan results,  -->
    <!-- making all BLE advertisements appear nameless. The ESP32's          -->
    <!-- advertised name "SCA-<classroomId>" was being stripped to "".      -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLUETOOTH_ADVERTISE removed: this app only SCANS, never advertises. -->

    <!-- ── BLE Permissions (Android < 12 / API ≤ 30) ────────────────────── -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- ── Location (required for BLE scan on all Android versions) ──────── -->
    <!-- Android 12+ with neverForLocation flag usually doesn't need this,   -->
    <!-- but some devices/OEMs still require it. Without neverForLocation,   -->
    <!-- ACCESS_FINE_LOCATION is required on all API levels for BLE scanning. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ── Foreground Service (required for reliable BLE on OEM Android) ─── -->
    <!-- Declares permission to start a foreground service. This prepares     -->
    <!-- the app for a future foreground service implementation that will     -->
    <!-- prevent OEM battery optimisation (Xiaomi MIUI, Realme UI,           -->
    <!-- Samsung One UI) from killing BLE scans mid-window.                  -->
    <!-- API 28+ base permission:                                             -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ typed permission (Android 14+):                             -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- ── BLE Feature Declaration ─────────────────────────────────────────── -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- ── Biometric Permissions ─────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
    android:label="Smart Campus"
    android:name="${applicationName}"
    android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
