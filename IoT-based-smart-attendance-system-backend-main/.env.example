# ============================================================
# Smart Campus Attendance — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# cp .env.example .env
# ============================================================


# ── Supabase ─────────────────────────────────────────────────────────────────
#
# Where to find these values:
#   1. Go to https://supabase.com/dashboard
#   2. Select your project
#   3. Click "Project Settings" (gear icon, left sidebar)
#   4. Click "API" tab
#
# SUPABASE_URL       → "Project URL"  (e.g. https://abcdefgh.supabase.co)
# SUPABASE_ANON_KEY  → "anon public" key (safe for client-side use)
# SUPABASE_SERVICE_KEY → "service_role" key (secret — backend only, never expose)
#
# JWT_SECRET:
#   Still in Project Settings → API → "JWT Settings" → "JWT Secret"
#   This is used to VERIFY JWTs issued by Supabase Auth.
#   It is NOT the service key.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
JWT_SECRET=your-supabase-jwt-secret


# ── MQTT Broker ───────────────────────────────────────────────────────────────
#
# If you have a local Mosquitto broker:   MQTT_BROKER=localhost
# If you have a cloud broker (e.g. HiveMQ): fill in the hostname.
# Leave as localhost if broker is not set up yet — startup will warn, not crash.

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=


# ── FastAPI ───────────────────────────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Allowed CORS origins — comma-separated, or * for all.
# Examples:
#   ALLOWED_ORIGINS=*
#   ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com
ALLOWED_ORIGINS=*
