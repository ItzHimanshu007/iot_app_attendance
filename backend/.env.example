# ============================================================
# Staff Attendance — backend environment
# ============================================================
# cp .env.example .env   and fill in the values.
# NEVER commit .env (it is git-ignored).
# On Render, set these in the dashboard instead.
# ============================================================

# ── Supabase (Dashboard → Project Settings → API) ───────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend-only key: legacy "service_role" key or new "sb_secret_..." key.
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional: publishable/anon key (sent when fetching the JWT public keys).
SUPABASE_ANON_KEY=
# Only for projects that still use the legacy HS256 "JWT Secret".
# New projects sign tokens with asymmetric keys — leave empty.
JWT_SECRET=

# ── FastAPI ─────────────────────────────────────────────────
DEBUG=true
# Comma-separated, or * (the mobile app does not need CORS).
ALLOWED_ORIGINS=*

# ── Attendance security tunables (defaults are fine) ────────
# CHALLENGE_TTL_SECONDS=120
# BEACON_WINDOW_SECONDS=30          # must equal TOKEN_WINDOW_SECONDS in firmware
# BEACON_CHALLENGE_PAST_WINDOWS=1
# BEACON_SUBMIT_PAST_WINDOWS=5
# LIVENESS_STEPS_COUNT=2
# FACE_MIN_SAMPLES=3
# BLOCK_EMULATORS=true
